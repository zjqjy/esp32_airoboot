# S3 里程碑关键配置 (sdkconfig 被 gitignore, 用 defaults 固化跨机器可复现)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000

# S4: N16R8 模组自带 8MB Octal PSRAM, 打开 (LVGL/后续 AI 模型用)
# ⚠️ 已有 sdkconfig 不会自动吃 defaults: 删掉 sdkconfig 重新 build, 或 menuconfig 手动勾
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y

# S4: LVGL 屏上性能浮层 (fps/CPU%), 上板调试用, 定稿录像前可关
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
